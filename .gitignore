# Each app (and core/, portal/) has its own .gitignore for what is specific to it; this one covers the whole repo.
__pycache__/
*.pyc
.pytest_cache/
/.idea/
.vscode/
*.log

# Local venvs: per app (python/, _python/ as in the old repos) and the suite-wide one (.venv-linux/).
python/
_python/
/.venv/
/.venv-*/

# MkDocs output, and the cache of its privacy plugin (the fonts it downloads at build time), which lands in the
# folder mkdocs is run from: anywhere, not only the root (29-10-2026: tools/.cache was committed)
/site/
.cache/

# The design panel's mock while `mkdocs serve` runs (tools/mkdocs/design_panel.py)
.design-mock.json

# OS and editor droppings (Linux/KDE, Windows, macOS)
*~
*.swp
.directory
.Trash-*/
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
