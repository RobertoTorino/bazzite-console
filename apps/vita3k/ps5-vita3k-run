#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Starts the Vita3K that Vita3K Manager installed, with the arguments given:
#
#   ps5-vita3k-run --frontend sdl -r PCSB00245              a game alone, quits with it (Game Mode, Play)
#   ps5-vita3k-run --firmware /path/to/PSP2UPDAT.PUP        install a part of the PS Vita firmware, no window
#   ps5-vita3k-run --pkg /path/to/game.pkg --zrif KEY      install a game from its package and license, no window
#   ps5-vita3k-run /path/to/game.vpk                        install a game (.vpk, .zip or a folder) and start it
#   ps5-vita3k-run                                          Vita3K's own window, for its settings
#
# The Steam shortcuts run this, not the AppImage, so they keep working when the app brings another Vita3K.
set -euo pipefail

APPIMAGE="${XDG_DATA_HOME:-$HOME/.local/share}/ps5-vita3k-manager/emulator/current/vita3k.AppImage"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '3,11p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi
[ -x "$APPIMAGE" ] || {
    echo "Vita3K is not installed: open Vita3K Manager and press Install." >&2
    exit 1
}
# Vita3K's AppImage mounts itself with its own FUSE library and the system's fusermount (part of Bazzite); without
# fusermount, it unpacks itself to a temporary folder on every start instead.
if ! command -v fusermount3 >/dev/null 2>&1 && ! command -v fusermount >/dev/null 2>&1; then
    export APPIMAGE_EXTRACT_AND_RUN=1
fi
# The AppImage brings a self-updater (bin/10-self-updater.hook): from its second start it asks whether it may check,
# and then writes the newest continuous build over itself, outside this app's pin. Off: a newer Vita3K comes with a
# new version of the app.
export DISABLE_AUTO_UPDATES=1
# A game started by Steam gets SDL told to ignore the controllers Steam handles, and Steam's virtual controller
# (28DE:11FF) in their place: no motion sensors or touchpad, and on the desktop it follows Steam's Desktop
# Configuration (mouse and keys). As shadPS4 Manager and Remote Play do: while a real controller is connected,
# Vita3K reads it and leaves Steam's virtual one out. Without a real one (a Steam Deck's own controls) Steam's choice
# stands.
INPUT_DEVICES="${PS5_INPUT_DEVICES:-/proc/bus/input/devices}"      # another file only in the tests
real_controller() {
    # A joystick (js handler) that is not one of Steam's (vendor 28DE).
    awk '/^I:/ { vendor = ""; for (i = 1; i <= NF; i++) if ($i ~ /^Vendor=/) vendor = tolower(substr($i, 8)) }
         /^H:/ && / js[0-9]/ && vendor != "28de" { found = 1 }
         END { exit !found }' "$INPUT_DEVICES" 2>/dev/null
}
if [ -n "${SDL_GAMECONTROLLER_IGNORE_DEVICES:-}${SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT:-}" ] && real_controller; then
    unset SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT
    export SDL_GAMECONTROLLER_IGNORE_DEVICES=0x28DE/0x11FF
fi
# On a Wayland desktop Vita3K opens its windows through Wayland itself (SDL for a game alone, Qt for its own window),
# and Steam sees only X11 windows: no overlay (Shift+Tab, the PS button) over a game it started. A game Steam starts
# there opens its window through XWayland, as shadPS4 Manager does for shadPS4. Game Mode is X11 already.
if [ -n "${SteamGameId:-}" ] && [ -n "${WAYLAND_DISPLAY:-}" ] && [ -n "${DISPLAY:-}" ]; then
    [ -n "${SDL_VIDEO_DRIVER:-}" ] || export SDL_VIDEO_DRIVER=x11
    [ -n "${QT_QPA_PLATFORM:-}" ] || export QT_QPA_PLATFORM=xcb
fi
# What Vita3K prints goes to the app's emulator log (owner, 26-11-2026), which the View logs tab shows beside the
# app's own. Before, it went to Steam's console only, where no one saw it. Every line has the home folder written
# as ~, so no user name is in it. The file turns over at 1 MB with three older ones kept, as the app's own log does.
# The wrapper stays while Vita3K runs, passes a stop on to it and ends with its exit code, so Steam sees the game
# end as before. SIGINT is passed on as SIGTERM: a program started in the background ignores SIGINT.
EMULATOR_LOG="${XDG_DATA_HOME:-$HOME/.local/share}/ps5-vita3k-manager/emulator.log"
{ [ -d "${EMULATOR_LOG%/*}" ] && : >>"$EMULATOR_LOG"; } 2>/dev/null || exec "$APPIMAGE" "$@"
size=$(stat -c %s "$EMULATOR_LOG" 2>/dev/null) || size=0
if [ "$size" -ge 1000000 ]; then
    { rm -f "$EMULATOR_LOG.3"
      for n in 2 1; do [ ! -e "$EMULATOR_LOG.$n" ] || mv -f "$EMULATOR_LOG.$n" "$EMULATOR_LOG.$((n + 1))"; done
      mv -f "$EMULATOR_LOG" "$EMULATOR_LOG.1"; } 2>/dev/null || true
fi
private_lines() {
    # Each line as it comes, the home folder written as ~ (and /home/<user> for /var/home/<user>, Bazzite's link),
    # as core's platform.private() does: only where the next character is not part of a longer name.
    awk 'function swap(text, from,   out, at, after) {
             out = ""
             while ((at = index(text, from)) > 0) {
                 after = substr(text, at + length(from), 1)
                 out = out substr(text, 1, at - 1) (after ~ /[A-Za-z0-9_]/ ? from : "~")
                 text = substr(text, at + length(from))
             }
             return out text
         }
         BEGIN { home = ENVIRON["HOME"]; sub(/\/+$/, "", home)
                 short = home ~ /^\/var\/home\// ? substr(home, 5) : "" }
         { line = length(home) > 1 ? swap($0, home) : $0
           if (short != "") line = swap(line, short)
           print line; fflush() }'
}
printf -v stamp '%(%d-%m-%Y %H:%M:%S)T' -1
printf '%s INFO Vita3K started: %s\n' "$stamp" "$*" | private_lines >>"$EMULATOR_LOG"
exec 3> >(private_lines >>"$EMULATOR_LOG")
writer=$!
emulator=""
trap '[ -z "$emulator" ] || kill -TERM "$emulator" 2>/dev/null || true' TERM INT
trap '[ -z "$emulator" ] || kill -HUP "$emulator" 2>/dev/null || true' HUP
"$APPIMAGE" "$@" <&0 >&3 2>&3 &
emulator=$!
status=0
wait "$emulator" || status=$?
while kill -0 "$emulator" 2>/dev/null; do        # the wait above was cut short by a stop passed on: wait again
    status=0
    wait "$emulator" || status=$?
done
exec 3>&-
wait "$writer" 2>/dev/null || true             # its last lines written, a last one without a newline ended
printf -v stamp '%(%d-%m-%Y %H:%M:%S)T' -1
printf '%s INFO Vita3K ended (exit code %s).\n' "$stamp" "$status" >>"$EMULATOR_LOG"
exit "$status"
